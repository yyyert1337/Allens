<Window x:Class="Allens.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewmodels="clr-namespace:Allens.ViewModels"
        xmlns:helpers="clr-namespace:Allens.Helpers"
        d:DataContext="{d:DesignInstance Type=viewmodels:MainWindowViewModel}"
        mc:Ignorable="d"
        Title="Allens" 
        Icon="Assets/app.ico" 
        Width="1130" Height="640"
        MinWidth="1130" MinHeight="640"
        MaxWidth="1130" MaxHeight="640"
        WindowStyle="None"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif"
        FontWeight="Normal"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        RenderOptions.ClearTypeHint="Enabled"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" 
                      ResizeBorderThickness="0" 
                      CornerRadius="0" 
                      GlassFrameThickness="0" 
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Grid>
        <!-- 3-Column Main Layout -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="210" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="240" />
            </Grid.ColumnDefinitions>

            <!-- 1. LEFT SIDEBAR: Brand + Polished Search + Categories -->
            <Border Grid.Column="0" Background="{StaticResource SidebarBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
                <Grid Margin="16,16,16,14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Brand Header -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="4,0,0,14" VerticalAlignment="Center">
                        <Border Width="24" Height="24" CornerRadius="6" Margin="0,0,10,0">
                            <Border.Background>
                                <ImageBrush ImageSource="Assets/logo.png" Stretch="UniformToFill"
                                            Viewbox="0.22,0.22,0.56,0.56" ViewboxUnits="RelativeToBoundingBox"
                                            RenderOptions.BitmapScalingMode="HighQuality" />
                            </Border.Background>
                        </Border>
                        <TextBlock Text="Allens" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- Modern Minimalist Search Box -->
                    <Grid Grid.Row="1" Margin="0,0,0,14" Height="30">
                        <TextBox x:Name="SearchInputBox" Style="{StaticResource SearchTextBoxStyle}" 
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                    </Grid>

                    <!-- Category Navigation List (Главная removed as requested) -->
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" helpers:SmoothScrollBehavior.IsSmoothScrollEnabled="True">
                        <StackPanel>
                            <TextBlock Text="КАТЕГОРИИ" Foreground="{StaticResource MutedTextBrush}" FontSize="9.5" FontWeight="SemiBold" Margin="8,0,0,5" />
                            
                            <Button Command="{Binding SelectCategoryCommand}" CommandParameter="Все приложения" Style="{StaticResource CategoryNavButtonStyle}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="📦" FontSize="12" Margin="0,0,8,0" />
                                    <TextBlock Text="Все приложения" />
                                </StackPanel>
                            </Button>
                            
                            <Button Command="{Binding SelectCategoryCommand}" CommandParameter="Браузеры" Style="{StaticResource CategoryNavButtonStyle}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🌐" FontSize="12" Margin="0,0,8,0" />
                                    <TextBlock Text="Браузеры" />
                                </StackPanel>
                            </Button>
                            
                            <Button Command="{Binding SelectCategoryCommand}" CommandParameter="Общение" Style="{StaticResource CategoryNavButtonStyle}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="💬" FontSize="12" Margin="0,0,8,0" />
                                    <TextBlock Text="Общение" />
                                </StackPanel>
                            </Button>
                            
                            <Button Command="{Binding SelectCategoryCommand}" CommandParameter="Игры" Style="{StaticResource CategoryNavButtonStyle}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🎮" FontSize="12" Margin="0,0,8,0" />
                                    <TextBlock Text="Игры" />
                                </StackPanel>
                            </Button>
                            
                            <Button Command="{Binding SelectCategoryCommand}" CommandParameter="Утилиты" Style="{StaticResource CategoryNavButtonStyle}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🛠️" FontSize="12" Margin="0,0,8,0" />
                                    <TextBlock Text="Утилиты" />
                                </StackPanel>
                            </Button>
                            
                            <Button Command="{Binding SelectCategoryCommand}" CommandParameter="Мультимедиа" Style="{StaticResource CategoryNavButtonStyle}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🎬" FontSize="12" Margin="0,0,8,0" />
                                    <TextBlock Text="Мультимедиа" />
                                </StackPanel>
                            </Button>
                            
                            <Button Command="{Binding SelectCategoryCommand}" CommandParameter="Разработка" Style="{StaticResource CategoryNavButtonStyle}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="💻" FontSize="12" Margin="0,0,8,0" />
                                    <TextBlock Text="Разработка" />
                                </StackPanel>
                            </Button>
                            
                            <Button Command="{Binding SelectCategoryCommand}" CommandParameter="Офис" Style="{StaticResource CategoryNavButtonStyle}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="📄" FontSize="12" Margin="0,0,8,0" />
                                    <TextBlock Text="Офис" />
                                </StackPanel>
                            </Button>
                            
                            <Button Command="{Binding SelectCategoryCommand}" CommandParameter="Система" Style="{StaticResource CategoryNavButtonStyle}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="⚙️" FontSize="12" Margin="0,0,8,0" />
                                    <TextBlock Text="Система" />
                                </StackPanel>
                            </Button>
                            
                            <Button Command="{Binding SelectCategoryCommand}" CommandParameter="Безопасность" Style="{StaticResource CategoryNavButtonStyle}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🛡️" FontSize="12" Margin="0,0,8,0" />
                                    <TextBlock Text="Безопасность" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Sidebar Footer -->
                    <Border Grid.Row="3" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="0,8,0,4" Margin="0,6,0,0">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="v1.0.1 • Portable" Foreground="{StaticResource MutedTextBrush}" FontSize="10.5" HorizontalAlignment="Center" />
                            <TextBlock Text="by yyyert" Foreground="{StaticResource SecondaryTextBrush}" FontSize="10" FontWeight="Medium" HorizontalAlignment="Center" Margin="0,2,0,0" />
                            
                            <Button Command="{Binding ManualCheckForUpdatesCommand}"
                                    Style="{StaticResource GhostButtonStyle}"
                                    Padding="6,2" Margin="0,3,0,1" Cursor="Hand"
                                    ToolTip="Проверить наличие новой версии Allens">
                                <TextBlock Text="Проверить обновления" FontSize="9.5" Foreground="{StaticResource MutedTextBrush}" />
                            </Button>
                            
                            <!-- Telegram Channel Link -->
                            <Button Command="{Binding OpenWebsiteCommand}" 
                                    CommandParameter="https://t.me/AHKstop"
                                    Cursor="Hand"
                                    Margin="0,5,0,2"
                                    HorizontalAlignment="Center"
                                    ToolTip="Открыть Telegram-канал @AHKstop">
                                <Button.Template>
                                    <ControlTemplate TargetType="{x:Type Button}">
                                        <Border x:Name="TelegramBadge"
                                                Background="#142483E2"
                                                BorderBrush="#332483E2"
                                                BorderThickness="1"
                                                CornerRadius="10"
                                                Padding="8,3,8,3">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Path Data="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm4.64 6.8c-.15 1.58-.8 5.42-1.13 7.19-.14.75-.42 1-.68 1.03-.58.05-1.02-.38-1.58-.75-.88-.58-1.38-.94-2.23-1.5-.99-.65-.35-1.01.22-1.59.15-.15 2.71-2.48 2.76-2.69a.2.2 0 0 0-.05-.18.24.24 0 0 0-.21-.02c-.09.02-1.49.95-4.22 2.79-.4.27-.76.41-1.08.4-.36-.01-1.04-.2-1.55-.37-.63-.2-1.12-.31-1.08-.66.02-.18.27-.36.74-.55 2.92-1.27 4.86-2.11 5.83-2.51 2.78-1.16 3.35-1.36 3.73-1.36.08 0 .27.02.39.12.1.08.13.19.14.27-.01.06.01.24 0 .38z" 
                                                      Fill="#FF2AABEE"
                                                      Width="13" 
                                                      Height="13" 
                                                      Stretch="Uniform" 
                                                      VerticalAlignment="Center" 
                                                      Margin="0,0,5,0" />
                                                <TextBlock Text="@AHKstop" 
                                                           Foreground="#FF2AABEE" 
                                                           FontSize="10.5" 
                                                           FontWeight="SemiBold" 
                                                           VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="TelegramBadge" Property="Background" Value="#252483E2" />
                                                <Setter TargetName="TelegramBadge" Property="BorderBrush" Value="#802483E2" />
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter TargetName="TelegramBadge" Property="Background" Value="#402483E2" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- 2. CENTER: Main Catalog Area -->
            <Grid Grid.Column="1" Margin="14,14,14,14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Section Header with Segmented Status Filters & Offline Banner -->
                <StackPanel Grid.Row="0" Margin="0,0,0,14">
                    <!-- App Update Banner (Visible when IsUpdateAvailable == true) -->
                    <Border Background="#20238636" 
                            BorderBrush="#602EA043" 
                            BorderThickness="1" 
                            CornerRadius="8" 
                            Padding="12,8" 
                            Margin="0,0,0,12"
                            Visibility="{Binding IsUpdateAvailable, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="🚀" FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center" />
                                <TextBlock Text="Доступна новая версия Allens: " Foreground="#FF7EE787" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding LatestAllensVersion, StringFormat='v{0}'}" Foreground="#FFFFFFFF" FontSize="11.5" FontWeight="Bold" Margin="4,0,0,0" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding UpdateStatusText}" Foreground="#FFAAAAAA" FontSize="11" Margin="10,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="Обновить Allens" 
                                        Command="{Binding ApplyAppUpdateCommand}"
                                        IsEnabled="{Binding IsUpdatingApp, Converter={StaticResource InverseBooleanConverter}}"
                                        Style="{StaticResource PrimaryButtonStyle}" 
                                        Padding="10,4" FontSize="11" Margin="0,0,8,0" />
                                <Button Content="✕" 
                                        Command="{Binding DismissUpdateBannerCommand}"
                                        Style="{StaticResource GhostButtonStyle}" 
                                        Width="20" Height="20" Padding="0" FontSize="10"
                                        ToolTip="Скрыть" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Offline Banner (Visible when IsInternetAvailable == false) -->
                    <Border Background="#25E5A020" 
                            BorderBrush="#60E5A020" 
                            BorderThickness="1" 
                            CornerRadius="8" 
                            Padding="12,8" 
                            Margin="0,0,0,12"
                            Visibility="{Binding IsInternetAvailable, Converter={StaticResource BooleanToVisibilityInverseConverter}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="⚠️" FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center" />
                                <TextBlock Text="Отсутствует подключение к интернету. Загрузка и обновление приложений временно недоступны." 
                                           Foreground="#FFFFD580" FontSize="11.5" FontWeight="Medium" VerticalAlignment="Center" />
                            </StackPanel>
                            <Button Grid.Column="1" 
                                    Content="Повторить" 
                                    Command="{Binding RetryInternetCommand}" 
                                    Style="{StaticResource SecondaryButtonStyle}" 
                                    Padding="10,3" 
                                    FontSize="10.5" 
                                    VerticalAlignment="Center" 
                                    Margin="8,0,0,0" />
                        </Grid>
                    </Border>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        
                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock Text="{Binding SelectedCategory}" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="Каталог проверенных программ" FontSize="11.5" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <!-- Status Filter Segmented Control -->
                    <Border Grid.Column="1" Background="#FF161616" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="2" VerticalAlignment="Center" Margin="8,0,0,0">
                        <StackPanel Orientation="Horizontal">
                            <!-- Все -->
                            <Button Content="Все" Command="{Binding SelectStatusFilterCommand}" CommandParameter="Все">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource StatusFilterButtonStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedStatusFilter}" Value="Все">
                                                <Setter Property="Background" Value="#FF282828" />
                                                <Setter Property="Foreground" Value="#FFFFFFFF" />
                                                <Setter Property="FontWeight" Value="SemiBold" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>

                            <!-- Установленные -->
                            <Button Content="Установленные" Command="{Binding SelectStatusFilterCommand}" CommandParameter="Установленные">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource StatusFilterButtonStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedStatusFilter}" Value="Установленные">
                                                <Setter Property="Background" Value="#FF282828" />
                                                <Setter Property="Foreground" Value="#FFFFFFFF" />
                                                <Setter Property="FontWeight" Value="SemiBold" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>

                            <!-- Не установленные -->
                            <Button Content="Не установленные" Command="{Binding SelectStatusFilterCommand}" CommandParameter="Не установленные">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource StatusFilterButtonStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedStatusFilter}" Value="Не установленные">
                                                <Setter Property="Background" Value="#FF282828" />
                                                <Setter Property="Foreground" Value="#FFFFFFFF" />
                                                <Setter Property="FontWeight" Value="SemiBold" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>

                            <!-- Обновления -->
                            <Button Content="Обновления" Command="{Binding SelectStatusFilterCommand}" CommandParameter="Есть обновления">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource StatusFilterButtonStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedStatusFilter}" Value="Есть обновления">
                                                <Setter Property="Background" Value="#FF282828" />
                                                <Setter Property="Foreground" Value="#FFFFFFFF" />
                                                <Setter Property="FontWeight" Value="SemiBold" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </StackPanel>
                    </Border>
                </Grid>
                </StackPanel>

                <!-- Empty State -->
                <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                            Visibility="{Binding FilteredApps.Count, Converter={StaticResource CountToVisibilityInverseConverter}}">
                    <TextBlock Text="Ничего не найдено" Foreground="{StaticResource TextBrush}" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center" />
                    <TextBlock Text="Попробуйте изменить категорию или поисковый запрос" Foreground="{StaticResource SecondaryTextBrush}" FontSize="11.5" Margin="0,3,0,0" HorizontalAlignment="Center" />
                </StackPanel>

                <!-- Ultra-Minimalist Compact Cards Grid -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                              helpers:SmoothScrollBehavior.IsSmoothScrollEnabled="True"
                              Visibility="{Binding FilteredApps.Count, Converter={StaticResource CountToVisibilityConverter}}">
                    <ItemsControl ItemsSource="{Binding FilteredApps}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Width="150" Height="156" Margin="0,0,10,12" Style="{StaticResource AppCardBorderStyle}">
                                    <Border.InputBindings>
                                        <MouseBinding MouseAction="LeftClick" 
                                                      Command="{Binding DataContext.OpenAppDetailsCommand, RelativeSource={RelativeSource AncestorType=Window}}" 
                                                      CommandParameter="{Binding}" />
                                    </Border.InputBindings>
                                    
                                    <Grid Margin="10">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        
                                        <!-- Top Row: Icon + Update Badge + CheckBox -->
                                        <Grid Grid.Row="0" Margin="0,0,0,7">
                                            <Border Width="32" Height="32" CornerRadius="6" Background="#FF1C1C1C" 
                                                    HorizontalAlignment="Left" Padding="2">
                                                <Image Source="{Binding IconPath}" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" />
                                            </Border>
                                            
                                            <!-- Update badge if available -->
                                            <Border Background="#25E5A020" BorderBrush="#55E5A020" BorderThickness="1" 
                                                    CornerRadius="3" Padding="4,1" Margin="38,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center"
                                                    Visibility="{Binding HasUpdate, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <TextBlock Text="NEW" Foreground="#FFE5A020" FontSize="8.5" FontWeight="Bold" />
                                            </Border>

                                            <CheckBox IsChecked="{Binding IsSelected}" HorizontalAlignment="Right" VerticalAlignment="Top" />
                                        </Grid>
                                        
                                        <!-- App Name -->
                                        <TextBlock Grid.Row="1" Text="{Binding Name}" FontWeight="SemiBold" FontSize="12" 
                                                   Foreground="{StaticResource TextBrush}" Margin="0,0,0,2" TextTrimming="CharacterEllipsis" />
                                        
                                        <!-- Exact Size & Status Indicator -->
                                        <StackPanel Grid.Row="2" Orientation="Horizontal" VerticalAlignment="Top">
                                            <TextBlock Text="{Binding DisplaySize}" Foreground="{StaticResource SecondaryTextBrush}" FontSize="10.5" />
                                            <TextBlock Text=" • ✓" Foreground="{StaticResource SuccessBrush}" FontSize="10.5" Margin="2,0,0,0" 
                                                       Visibility="{Binding IsInstalled, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                        </StackPanel>
                                        
                                        <!-- Minimal Action Buttons: Install / Update / Uninstall / Launch -->
                                        <Grid Grid.Row="3" Margin="0,4,0,0" Height="28">
                                            <!-- Install Button -->
                                            <Button Height="28" HorizontalAlignment="Stretch"
                                                    Command="{Binding DataContext.InstallAppCommand, RelativeSource={RelativeSource AncestorType=Window}}" 
                                                    CommandParameter="{Binding}">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
                                                        <Setter Property="Content" Value="Установить" />
                                                        <Setter Property="FontSize" Value="11" />
                                                        <Setter Property="Padding" Value="0" />
                                                        <Setter Property="Visibility" Value="Visible" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsInstalled}" Value="True">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>

                                            <!-- Update Button (When installed AND HasUpdate == true) -->
                                            <Button Height="28" HorizontalAlignment="Stretch"
                                                    Command="{Binding DataContext.InstallAppCommand, RelativeSource={RelativeSource AncestorType=Window}}" 
                                                    CommandParameter="{Binding}">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
                                                        <Setter Property="Content" Value="Обновить" />
                                                        <Setter Property="Background" Value="#FFE5A020" />
                                                        <Setter Property="Foreground" Value="#FF0A0A0A" />
                                                        <Setter Property="FontWeight" Value="SemiBold" />
                                                        <Setter Property="FontSize" Value="11" />
                                                        <Setter Property="Padding" Value="0" />
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <MultiDataTrigger>
                                                                <MultiDataTrigger.Conditions>
                                                                    <Condition Binding="{Binding IsInstalled}" Value="True" />
                                                                    <Condition Binding="{Binding HasUpdate}" Value="True" />
                                                                </MultiDataTrigger.Conditions>
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </MultiDataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>

                                            <!-- Installed & Up-to-date: Launch (White) + Delete (Red) -->
                                            <Grid Height="28">
                                                <Grid.Style>
                                                    <Style TargetType="Grid">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <MultiDataTrigger>
                                                                <MultiDataTrigger.Conditions>
                                                                    <Condition Binding="{Binding IsInstalled}" Value="True" />
                                                                    <Condition Binding="{Binding HasUpdate}" Value="False" />
                                                                </MultiDataTrigger.Conditions>
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </MultiDataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Grid.Style>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="28" />
                                                </Grid.ColumnDefinitions>
                                                <Button Grid.Column="0" Content="Запустить" Margin="0,0,4,0" Height="28"
                                                        Command="{Binding DataContext.LaunchAppCommand, RelativeSource={RelativeSource AncestorType=Window}}" 
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource CardLaunchButtonStyle}"
                                                        ToolTip="Запустить приложение" />
                                                <Button Grid.Column="1" Height="28" Width="28"
                                                        Command="{Binding DataContext.UninstallCommand, RelativeSource={RelativeSource AncestorType=Window}}" 
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource CardDeleteButtonStyle}"
                                                        ToolTip="Удалить приложение" />
                                            </Grid>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- Bottom Floating Action Bar for Selected Apps (Animated Slide Up) -->
                <Border Grid.Row="2" Background="{StaticResource SidebarBrush}" CornerRadius="8" Padding="14,8" Margin="0,10,0,0" 
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                    <Border.RenderTransform>
                        <TranslateTransform Y="16" />
                    </Border.RenderTransform>
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Setter Property="Opacity" Value="0" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedCount, Converter={StaticResource CountToVisibilityConverter}}" Value="Visible">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <DataTrigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                 To="1" Duration="0:0:0.2">
                                                    <DoubleAnimation.EasingFunction>
                                                        <CubicEase EasingMode="EaseOut" />
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                                                 From="16" To="0" Duration="0:0:0.22">
                                                    <DoubleAnimation.EasingFunction>
                                                        <CubicEase EasingMode="EaseOut" />
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </DataTrigger.EnterActions>
                                    <DataTrigger.ExitActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                 To="0" Duration="0:0:0.15" />
                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                                                 To="16" Duration="0:0:0.15" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </DataTrigger.ExitActions>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Выбрано: " Foreground="{StaticResource SecondaryTextBrush}" FontSize="11.5" />
                            <TextBlock Text="{Binding SelectedCount}" Foreground="{StaticResource TextBrush}" FontWeight="SemiBold" FontSize="11.5" />
                        </StackPanel>
                        
                        <Button Content="Установить выбранные" Style="{StaticResource AccentButtonStyle}" 
                                HorizontalAlignment="Right" Command="{Binding InstallSelectedCommand}" />
                    </Grid>
                </Border>
            </Grid>

            <!-- 3. RIGHT SIDEBAR: Actions Queue + Frameless Window Controls -->
            <Border Grid.Column="2" Background="{StaticResource SidebarBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1,0,0,0">
                <Grid Margin="16,12,16,14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    
                    <!-- Top Window Controls (Minimal Minimize and Close buttons) -->
                    <Grid Grid.Row="0" Margin="0,0,0,14">
                        <TextBlock Text="Действия" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" />
                        
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Style="{StaticResource WindowMinButtonStyle}" Click="MinimizeButton_Click" Margin="0,0,4,0" />
                            <Button Style="{StaticResource WindowCloseButtonStyle}" Click="CloseButton_Click" />
                        </StackPanel>
                    </Grid>
                    
                    <!-- Empty State -->
                    <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="10,0"
                                Visibility="{Binding QueueService.Queue.Count, Converter={StaticResource CountToVisibilityInverseConverter}}">
                        <TextBlock Text="Нет активных задач" Foreground="{StaticResource SecondaryTextBrush}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" />
                        <TextBlock Text="Здесь отображается ход установки и удаления" Foreground="{StaticResource MutedTextBrush}" FontSize="10.5" Margin="0,4,0,0" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" />
                    </StackPanel>
                    
                    <!-- Queue & Activity List -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                  helpers:SmoothScrollBehavior.IsSmoothScrollEnabled="True"
                                  Visibility="{Binding QueueService.Queue.Count, Converter={StaticResource CountToVisibilityConverter}}">
                        <ItemsControl ItemsSource="{Binding QueueService.Queue}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource CardBrush}" CornerRadius="6" Padding="11" Margin="0,0,0,7"
                                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                            Opacity="{Binding Opacity}">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            
                                            <Grid Grid.Row="0">
                                                <TextBlock Text="{Binding App.Name}" FontWeight="SemiBold" FontSize="11.5" Foreground="{StaticResource TextBrush}" />
                                                <Button Content="✕" FontSize="8.5" Width="14" Height="14" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                        Style="{StaticResource GhostButtonStyle}" Padding="0" Cursor="Hand"
                                                        Command="{Binding DataContext.DismissQueueItemCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"
                                                        ToolTip="Скрыть" />
                                            </Grid>
                                            
                                            <Grid Grid.Row="1" Margin="0,3,0,5">
                                                <TextBlock Text="{Binding StatusMessage}" FontSize="10" VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Status}" Value="Error">
                                                                    <Setter Property="Foreground" Value="#FFFF5555" />
                                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <TextBlock Text="{Binding ProgressText}" FontSize="9.5" Foreground="{StaticResource MutedTextBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                            </Grid>
                                            
                                            <ProgressBar Grid.Row="2" Value="{Binding ProgressPercentage}" Maximum="100" Height="3" BorderThickness="0" 
                                                         Background="#FF222222" Foreground="#FFFFFFFF">
                                                <ProgressBar.Style>
                                                    <Style TargetType="ProgressBar">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Status}" Value="Error">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ProgressBar.Style>
                                            </ProgressBar>

                                            <!-- Error Action Buttons (visible only on Error) -->
                                            <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,6,0,0">
                                                <StackPanel.Style>
                                                    <Style TargetType="StackPanel">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Status}" Value="Error">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </StackPanel.Style>

                                                <Button Content="Копировать отчёт"
                                                        Command="{Binding DataContext.CopyErrorReportCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"
                                                        Padding="6,3" FontSize="9.5" Margin="0,0,6,0"
                                                        Style="{StaticResource GhostButtonStyle}"
                                                        BorderBrush="#FF333333" BorderThickness="1"
                                                        ToolTip="Скопировать технический отчёт об ошибке" />

                                                <Button Content="Сообщить в TG"
                                                        Command="{Binding DataContext.ReportErrorToTelegramCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"
                                                        Padding="6,3" FontSize="9.5"
                                                        Style="{StaticResource GhostButtonStyle}"
                                                        Foreground="#FF58A6FF" BorderBrush="#FF1F6FEB" BorderThickness="1"
                                                        ToolTip="Открыть Telegram-чат разработчика и сообщить об ошибке" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- Bottom Actions Panel Footer: Cache Cleanup -->
                    <Border Grid.Row="2" Background="#FF161616" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,10,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="Кэш загрузок" Foreground="{StaticResource SecondaryTextBrush}" FontSize="10.5" FontWeight="Medium" />
                                <TextBlock Text="{Binding DownloadCacheSize}" Foreground="{StaticResource TextBrush}" FontWeight="SemiBold" FontSize="11.5" Margin="0,1,0,0" />
                            </StackPanel>
                            <Button Grid.Column="1" Content="Очистить"
                                    Command="{Binding ClearCacheCommand}"
                                    FocusVisualStyle="{x:Null}"
                                    Style="{StaticResource DangerButtonStyle}"
                                    Padding="10,4" FontSize="10.5" FontWeight="SemiBold"
                                    VerticalAlignment="Center"
                                    ToolTip="Очистить загруженные установочные файлы" />
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- Floating Snackbar Toast Notification with Slide + Fade Animation -->
        <Border VerticalAlignment="Bottom" HorizontalAlignment="Center" 
                Margin="0,0,0,20" Padding="16,9" Background="#FF1E1E1E" CornerRadius="8" 
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                Panel.ZIndex="100">
            <Border.RenderTransform>
                <TranslateTransform Y="20" />
            </Border.RenderTransform>
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Setter Property="Opacity" Value="0" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsSnackbarVisible}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                            <DataTrigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                         To="1" Duration="0:0:0.2">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                                         From="20" To="0" Duration="0:0:0.22">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="0:0:0.18" />
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                                         To="15" Duration="0:0:0.18" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <TextBlock Text="{Binding SnackbarMessage}" Foreground="{StaticResource TextBrush}" FontSize="12" FontWeight="SemiBold" />
        </Border>

        <!-- APP DETAILS SIDE DRAWER OVERLAY (Smooth Slide + Fade) -->
        <Grid Panel.ZIndex="40" IsHitTestVisible="{Binding IsDetailsOpen}">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Opacity" Value="0" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsDetailsOpen}" Value="True">
                            <DataTrigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                         To="1" Duration="0:0:0.18">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="0:0:0.18">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>

            <!-- Scrim / Dimmed Backdrop (Click to close) -->
            <Border Background="#77000000">
                <Border.InputBindings>
                    <MouseBinding MouseAction="LeftClick" Command="{Binding CloseAppDetailsCommand}" />
                </Border.InputBindings>
            </Border>

            <!-- Slide-in Drawer (Docked to right, 360px wide) -->
            <Border HorizontalAlignment="Right" Width="360" Background="#FF141414" 
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1,0,0,0">
                <Border.RenderTransform>
                    <TranslateTransform X="380" />
                </Border.RenderTransform>
                <Border.Style>
                    <Style TargetType="Border">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsDetailsOpen}" Value="True">
                                <DataTrigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                             From="380" To="0" Duration="0:0:0.20">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.EnterActions>
                                <DataTrigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                             To="380" Duration="0:0:0.18">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseIn" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.ExitActions>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <Grid Margin="20,16,20,16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <Grid Grid.Row="0" Margin="0,0,0,16">
                        <TextBlock Text="Свойства программы" FontSize="12.5" FontWeight="SemiBold" 
                                   Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center" />
                        <Button Style="{StaticResource GhostButtonStyle}" 
                                Command="{Binding CloseAppDetailsCommand}" 
                                HorizontalAlignment="Right" Width="28" Height="28" Padding="0">
                            <TextBlock Text="✕" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Button>
                    </Grid>

                    <!-- Scrollable Details -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,-8,0" Padding="0,0,8,0"
                                  helpers:SmoothScrollBehavior.IsSmoothScrollEnabled="True">
                        <StackPanel>
                            <!-- Hero: Icon + Name + Publisher + Badges -->
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Width="48" Height="48" CornerRadius="8" Background="#FF1A1A1A" 
                                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Margin="0,0,14,0" Padding="5">
                                    <Image Source="{Binding SelectedAppDetails.IconPath}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
                                </Border>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding SelectedAppDetails.Name}" FontSize="15" FontWeight="SemiBold" 
                                               Foreground="{StaticResource TextBrush}" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding SelectedAppDetails.Publisher}" FontSize="11" 
                                               Foreground="{StaticResource SecondaryTextBrush}" Margin="0,2,0,5" />
                                    
                                    <WrapPanel>
                                        <!-- Category Badge -->
                                        <Border Background="#FF1E1E1E" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" 
                                                CornerRadius="4" Padding="6,2" Margin="0,0,5,4">
                                            <TextBlock Text="{Binding SelectedAppDetails.Category}" FontSize="9.5" Foreground="{StaticResource SecondaryTextBrush}" />
                                        </Border>

                                        <!-- Installed Badge -->
                                        <Border Background="#2030D158" BorderBrush="#5530D158" BorderThickness="1" 
                                                CornerRadius="4" Padding="6,2" Margin="0,0,5,4"
                                                Visibility="{Binding SelectedAppDetails.IsInstalled, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <TextBlock Text="✓ Установлено" FontSize="9.5" Foreground="{StaticResource SuccessBrush}" FontWeight="SemiBold" />
                                        </Border>

                                        <!-- Not Installed Badge -->
                                        <Border Background="#FF1E1E1E" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" 
                                                CornerRadius="4" Padding="6,2" Margin="0,0,5,4"
                                                Visibility="{Binding SelectedAppDetails.IsInstalled, Converter={StaticResource BooleanToVisibilityInverseConverter}}">
                                            <TextBlock Text="Не установлено" FontSize="9.5" Foreground="{StaticResource MutedTextBrush}" />
                                        </Border>

                                        <!-- Update Available Badge -->
                                        <Border Background="#25E5A020" BorderBrush="#66E5A020" BorderThickness="1" 
                                                CornerRadius="4" Padding="6,2" Margin="0,0,5,4"
                                                Visibility="{Binding SelectedAppDetails.HasUpdate, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <TextBlock Text="Доступно обновление" FontSize="9.5" Foreground="#FFE5A020" FontWeight="SemiBold" />
                                        </Border>
                                    </WrapPanel>
                                </StackPanel>
                            </Grid>

                            <!-- Divider -->
                            <Rectangle Height="1" Fill="{StaticResource BorderBrush}" Margin="0,0,0,12" />

                            <!-- Description -->
                            <TextBlock Text="ОПИСАНИЕ" FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,5" />
                            <TextBlock Text="{Binding SelectedAppDetails.Description}" FontSize="12" Foreground="{StaticResource TextBrush}" 
                                       TextWrapping="Wrap" LineHeight="18" Margin="0,0,0,14" />

                            <!-- Divider -->
                            <Rectangle Height="1" Fill="{StaticResource BorderBrush}" Margin="0,0,0,12" />

                            <!-- Specifications -->
                            <TextBlock Text="СПЕЦИФИКАЦИЯ" FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,8" />
                            
                            <Grid Margin="0,0,0,6">
                                <TextBlock Text="Версия в каталоге" FontSize="11.5" Foreground="{StaticResource SecondaryTextBrush}" />
                                <TextBlock Text="{Binding SelectedAppDetails.Version}" FontSize="11.5" Foreground="{StaticResource TextBrush}" HorizontalAlignment="Right" />
                            </Grid>

                            <Grid Margin="0,0,0,6" Visibility="{Binding SelectedAppDetails.IsInstalled, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock Text="Установленная версия" FontSize="11.5" Foreground="{StaticResource SecondaryTextBrush}" />
                                <TextBlock Text="{Binding SelectedAppDetails.InstalledVersion, FallbackValue='—'}" FontSize="11.5" Foreground="{StaticResource TextBrush}" HorizontalAlignment="Right" />
                            </Grid>

                            <Grid Margin="0,0,0,6">
                                <TextBlock Text="Размер установщика" FontSize="11.5" Foreground="{StaticResource SecondaryTextBrush}" />
                                <TextBlock Text="{Binding SelectedAppDetails.SizeDisplay}" FontSize="11.5" Foreground="{StaticResource TextBrush}" HorizontalAlignment="Right" />
                            </Grid>

                            <Grid Margin="0,0,0,6" Visibility="{Binding SelectedAppDetails.IsInstalled, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock Text="Размер на диске" FontSize="11.5" Foreground="{StaticResource SecondaryTextBrush}" />
                                <TextBlock Text="{Binding SelectedAppDetails.InstalledSizeDisplay, FallbackValue='—'}" FontSize="11.5" Foreground="{StaticResource TextBrush}" HorizontalAlignment="Right" />
                            </Grid>

                            <Grid Margin="0,0,0,6">
                                <TextBlock Text="Архитектура" FontSize="11.5" Foreground="{StaticResource SecondaryTextBrush}" />
                                <TextBlock Text="{Binding SelectedAppDetails.Architecture}" FontSize="11.5" Foreground="{StaticResource TextBrush}" HorizontalAlignment="Right" />
                            </Grid>

                            <Grid Margin="0,0,0,6">
                                <TextBlock Text="Тип инсталлятора" FontSize="11.5" Foreground="{StaticResource SecondaryTextBrush}" />
                                <TextBlock Text="{Binding SelectedAppDetails.InstallerType}" FontSize="11.5" Foreground="{StaticResource TextBrush}" HorizontalAlignment="Right" />
                            </Grid>

                            <!-- Divider -->
                            <Rectangle Height="1" Fill="{StaticResource BorderBrush}" Margin="0,6,0,12" />

                            <!-- Install Location -->
                            <TextBlock Text="ПУТЬ УСТАНОВКИ" FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,6" />
                            <Border Background="#FF191919" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding SelectedAppDetails.InstalledPath}" 
                                               ToolTip="{Binding SelectedAppDetails.InstalledPath}"
                                               FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" 
                                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                    <Button Grid.Column="1" Content="Папка ↗" Style="{StaticResource GhostButtonStyle}" 
                                            FontSize="10" Padding="6,2" Margin="6,0,0,0"
                                            Command="{Binding OpenInstallFolderCommand}" 
                                            CommandParameter="{Binding SelectedAppDetails.InstalledPath}"
                                            Visibility="{Binding SelectedAppDetails.IsInstalled, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                </Grid>
                            </Border>

                            <!-- Official Website Link -->
                            <TextBlock Text="ОФИЦИАЛЬНЫЙ САЙТ" FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource MutedTextBrush}" Margin="0,4,0,5" />
                            <Button Style="{StaticResource GhostButtonStyle}" HorizontalContentAlignment="Left" Padding="8,6"
                                    Command="{Binding OpenWebsiteCommand}" CommandParameter="{Binding SelectedAppDetails.Website}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🌐" FontSize="11" Margin="0,0,8,0" />
                                    <TextBlock Text="{Binding SelectedAppDetails.Website}" FontSize="11" Foreground="#FF6BA4FF" TextDecorations="Underline" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Bottom Action Controls inside Drawer -->
                    <Border Grid.Row="2" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="0,14,0,0">
                        <Grid>
                            <!-- Not Installed: Install Button -->
                            <Button Content="Установить программу" Style="{StaticResource PrimaryButtonStyle}" Height="34"
                                    Command="{Binding InstallAppCommand}" CommandParameter="{Binding SelectedAppDetails}"
                                    Visibility="{Binding SelectedAppDetails.IsInstalled, Converter={StaticResource BooleanToVisibilityInverseConverter}}" />

                            <!-- Installed: Action Controls (Launch + Update/Reinstall + Uninstall + Force Uninstall) -->
                            <StackPanel Visibility="{Binding SelectedAppDetails.IsInstalled, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <!-- Launch Application -->
                                <Button Content="▶ Запустить программу" Style="{StaticResource PrimaryButtonStyle}" Height="34" Margin="0,0,0,8"
                                        FontWeight="SemiBold"
                                        Command="{Binding LaunchAppCommand}" CommandParameter="{Binding SelectedAppDetails}" />

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    
                                    <Button Grid.Column="0" Margin="0,0,8,0" Height="34"
                                            Command="{Binding InstallAppCommand}" CommandParameter="{Binding SelectedAppDetails}">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
                                                <Setter Property="Content" Value="Переустановить" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SelectedAppDetails.HasUpdate}" Value="True">
                                                        <Setter Property="Content" Value="Обновить программу" />
                                                        <Setter Property="Background" Value="#FFE5A020" />
                                                        <Setter Property="Foreground" Value="#FF0A0A0A" />
                                                        <Setter Property="FontWeight" Value="SemiBold" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>

                                    <Button Grid.Column="1" Content="Удалить" Style="{StaticResource DangerButtonStyle}" Height="34" Width="90"
                                            Command="{Binding UninstallCommand}" CommandParameter="{Binding SelectedAppDetails}" />
                                </Grid>

                                <Button Margin="0,8,0,0" Height="34" HorizontalAlignment="Stretch"
                                        ToolTip="Принудительно завершить процессы, удалить файлы из папки, ярлыки и следы в реестре без запуска штатного деинсталлятора"
                                        Command="{Binding ForceUninstallCommand}" CommandParameter="{Binding SelectedAppDetails}">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource GhostButtonStyle}">
                                            <Setter Property="Background" Value="#12EF5350" />
                                            <Setter Property="BorderBrush" Value="#44EF5350" />
                                            <Setter Property="Padding" Value="8,0" />
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#25EF5350" />
                                                    <Setter Property="BorderBrush" Value="#88EF5350" />
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="⚡" FontSize="11" Margin="0,0,6,0" Foreground="#FFEF5350" VerticalAlignment="Center" />
                                        <TextBlock Text="Принудительное удаление (зачистка)" FontSize="11.5" FontWeight="SemiBold" Foreground="#FFEF5350" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- MODERN IN-APP MODAL DIALOG OVERLAY (Smooth Pop + Fade) -->
        <Grid Background="#CC000000" Panel.ZIndex="50" IsHitTestVisible="{Binding IsDialogOpen}">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Opacity" Value="0" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsDialogOpen}" Value="True">
                            <DataTrigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                         To="1" Duration="0:0:0.18">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="0:0:0.15">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseIn" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>

            <!-- Dialog Box Container -->
            <Grid Width="380" HorizontalAlignment="Center" VerticalAlignment="Center">
                <!-- Underlay Shadow Border (Keeps shadow while preserving 100% sharp ClearType on text) -->
                <Border CornerRadius="10" Background="#FF161616">
                    <Border.Effect>
                        <DropShadowEffect Color="Black" BlurRadius="28" Opacity="0.8" Direction="270" ShadowDepth="8" />
                    </Border.Effect>
                </Border>

                <!-- Content Border (No Effect applied, razor-sharp text) -->
                <Border Background="#FF161616" BorderBrush="#FF2A2A2A" BorderThickness="1" 
                        CornerRadius="10" Padding="20">
                    <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Title -->
                    <TextBlock Grid.Row="0" Text="{Binding DialogTitle}" FontSize="14.5" FontWeight="SemiBold" 
                               Foreground="{StaticResource TextBrush}" TextWrapping="Wrap" Margin="0,0,0,6" />

                    <!-- Message Body -->
                    <TextBlock Grid.Row="1" Text="{Binding DialogMessage}" FontSize="12" 
                               Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" LineHeight="17" Margin="0,0,0,18" />

                    <!-- Action Buttons -->
                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                        <!-- Cancel Button -->
                        <Button Content="{Binding DialogCancelText}" Style="{StaticResource GhostButtonStyle}" 
                                Command="{Binding DialogCancelCommand}" Margin="0,0,8,0"
                                Visibility="{Binding DialogHasCancel, Converter={StaticResource BooleanToVisibilityConverter}}" />

                        <!-- Confirm / Action Button -->
                        <Button Content="{Binding DialogConfirmText}" Command="{Binding DialogConfirmCommand}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding DialogIsDanger}" Value="True">
                                            <Setter Property="Background" Value="{StaticResource DangerBrush}" />
                                            <Setter Property="Foreground" Value="#FFFFFFFF" />
                                            <Setter Property="BorderThickness" Value="0" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
            </Grid>
        </Grid>

    </Grid>
</Window>
